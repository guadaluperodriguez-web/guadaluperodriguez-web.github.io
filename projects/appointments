<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Appointment Web App — Guadalupe Rodríguez</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a0f; --surface: #111118; --surface2: #16161f;
      --border: rgba(255,255,255,.07); --text: #e8e8f0; --muted: #6b6b80;
      --accent: #a78bfa; --accent2: #f472b6; --accent3: #34d399;
      --font-mono: 'DM Mono', monospace; --font-body: 'DM Sans', sans-serif;
    }
    body { background: var(--bg); color: var(--text); font-family: var(--font-body); font-weight: 300; min-height: 100vh; }

    .topbar {
      background: var(--surface); border-bottom: 1px solid var(--border);
      padding: .9rem 2rem; display: flex; align-items: center; gap: 1rem;
      position: sticky; top: 0; z-index: 100;
    }
    .back-btn {
      font-family: var(--font-mono); font-size: .72rem; color: var(--muted);
      text-decoration: none; border: 1px solid var(--border); padding: .35rem .9rem; transition: all .2s;
    }
    .back-btn:hover { border-color: var(--accent); color: var(--accent); }
    .topbar-title { font-family: var(--font-mono); font-size: .8rem; }
    .topbar-tags { display: flex; gap: .4rem; margin-left: auto; }
    .badge { font-family: var(--font-mono); font-size: .62rem; padding: .2rem .6rem; border: 1px solid var(--border); color: var(--muted); }

    .layout { display: grid; grid-template-columns: 1fr 380px; gap: 0; min-height: calc(100vh - 49px); }

    /* CALENDAR SIDE */
    .calendar-side { border-right: 1px solid var(--border); padding: 2rem; }
    .cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
    .cal-month { font-family: var(--font-mono); font-size: .88rem; }
    .cal-nav { display: flex; gap: .5rem; }
    .cal-nav-btn {
      background: transparent; border: 1px solid var(--border); color: var(--muted);
      padding: .3rem .7rem; font-family: var(--font-mono); font-size: .75rem;
      cursor: pointer; transition: all .2s;
    }
    .cal-nav-btn:hover { border-color: var(--accent); color: var(--accent); }
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
    .cal-day-label { text-align: center; font-family: var(--font-mono); font-size: .6rem; color: var(--muted); padding: .5rem; letter-spacing: .08em; }
    .cal-cell {
      min-height: 70px; background: var(--surface2); border: 1px solid var(--border);
      padding: .4rem; cursor: pointer; transition: all .2s; position: relative;
    }
    .cal-cell:hover { border-color: rgba(167,139,250,.3); background: rgba(167,139,250,.05); }
    .cal-cell.selected { border-color: var(--accent); background: rgba(167,139,250,.1); }
    .cal-cell.today { border-color: rgba(52,211,153,.4); }
    .cal-cell.other-month { opacity: .3; }
    .cal-date { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); }
    .cal-cell.today .cal-date { color: var(--accent3); }
    .cal-cell.selected .cal-date { color: var(--accent); }
    .appt-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); margin: 2px 1px; display: inline-block; }

    /* Appointments list side */
    .appt-side { display: flex; flex-direction: column; }
    .appt-header {
      padding: 1.5rem; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
    }
    .appt-day-title { font-family: var(--font-mono); font-size: .82rem; }
    .add-btn {
      background: var(--accent); color: #0a0a0f; border: none;
      padding: .45rem 1rem; font-family: var(--font-mono); font-size: .68rem;
      cursor: pointer; transition: all .2s;
    }
    .add-btn:hover { background: var(--accent2); }
    .appt-list { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: .6rem; }
    .appt-card {
      background: var(--surface2); border: 1px solid var(--border);
      padding: 1rem; display: flex; align-items: flex-start; gap: .8rem;
      transition: border-color .2s;
    }
    .appt-card:hover { border-color: rgba(167,139,250,.3); }
    .appt-time-col { text-align: center; flex-shrink: 0; }
    .appt-time { font-family: var(--font-mono); font-size: .78rem; color: var(--accent); }
    .appt-time-end { font-family: var(--font-mono); font-size: .62rem; color: var(--muted); }
    .appt-line { width: 1px; height: 30px; background: var(--border); margin: .2rem auto; }
    .appt-info { flex: 1; }
    .appt-title { font-size: .85rem; margin-bottom: .2rem; }
    .appt-sub { font-family: var(--font-mono); font-size: .62rem; color: var(--muted); }
    .appt-del {
      background: transparent; border: none; color: var(--muted);
      cursor: pointer; font-size: .9rem; transition: color .2s; padding: .1rem .3rem;
    }
    .appt-del:hover { color: #f87171; }
    .appt-status {
      display: inline-block; padding: .1rem .5rem; margin-top: .4rem;
      font-family: var(--font-mono); font-size: .58rem; letter-spacing: .06em;
    }
    .status-confirmed { background: rgba(52,211,153,.1); color: var(--accent3); border: 1px solid rgba(52,211,153,.2); }
    .status-pending { background: rgba(251,191,36,.1); color: #fbbf24; border: 1px solid rgba(251,191,36,.2); }
    .no-appts { text-align: center; padding: 3rem 1rem; font-family: var(--font-mono); font-size: .75rem; color: var(--muted); }

    /* Modal */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.7); backdrop-filter: blur(4px); z-index: 1000; display: none; align-items: center; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal { background: var(--surface); border: 1px solid var(--border); width: 400px; padding: 2rem; }
    .modal-title { font-family: var(--font-mono); font-size: .85rem; margin-bottom: 1.5rem; }
    .field { display: flex; flex-direction: column; gap: .4rem; margin-bottom: 1rem; }
    .field label { font-family: var(--font-mono); font-size: .62rem; color: var(--muted); letter-spacing: .1em; text-transform: uppercase; }
    .field input, .field select {
      background: var(--surface2); border: 1px solid var(--border); color: var(--text);
      padding: .6rem .9rem; font-family: var(--font-mono); font-size: .78rem;
      outline: none; transition: border-color .2s;
    }
    .field input:focus, .field select:focus { border-color: rgba(167,139,250,.4); }
    .field select option { background: var(--surface2); }
    .modal-actions { display: flex; gap: .8rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn-cancel { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: .5rem 1.2rem; font-family: var(--font-mono); font-size: .72rem; cursor: pointer; transition: all .2s; }
    .btn-cancel:hover { color: var(--text); }
  </style>
</head>
<body>
  <div class="topbar">
    <a href="../../index.html" class="back-btn">← Back</a>
    <span class="topbar-title">Appointment Web App</span>
    <div class="topbar-tags">
      <span class="badge">Java</span><span class="badge">HTML</span><span class="badge">CSS</span>
    </div>
  </div>

  <div class="layout">
    <!-- Calendar -->
    <div class="calendar-side">
      <div class="cal-header">
        <div class="cal-month" id="cal-month-label">May 2026</div>
        <div class="cal-nav">
          <button class="cal-nav-btn" onclick="changeMonth(-1)">‹</button>
          <button class="cal-nav-btn" onclick="changeMonth(1)">›</button>
        </div>
      </div>
      <div class="cal-grid">
        <div class="cal-day-label">SUN</div><div class="cal-day-label">MON</div>
        <div class="cal-day-label">TUE</div><div class="cal-day-label">WED</div>
        <div class="cal-day-label">THU</div><div class="cal-day-label">FRI</div>
        <div class="cal-day-label">SAT</div>
        <div id="cal-cells"></div>
      </div>
    </div>

    <!-- Appointments -->
    <div class="appt-side">
      <div class="appt-header">
        <div class="appt-day-title" id="selected-date-label">Select a day</div>
        <button class="add-btn" onclick="openModal()">+ New Appointment</button>
      </div>
      <div class="appt-list" id="appt-list"></div>
    </div>
  </div>

  <!-- Modal -->
  <div class="modal-overlay" id="modal">
    <div class="modal">
      <div class="modal-title">New Appointment</div>
      <div class="field"><label>Title / Reason</label><input type="text" id="f-title" placeholder="e.g. Medical Checkup"></div>
      <div class="field"><label>Patient / Person</label><input type="text" id="f-person" placeholder="Full name"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="field"><label>Start Time</label><input type="time" id="f-start" value="09:00"></div>
        <div class="field"><label>End Time</label><input type="time" id="f-end" value="09:30"></div>
      </div>
      <div class="field">
        <label>Status</label>
        <select id="f-status"><option value="confirmed">Confirmed</option><option value="pending">Pending</option></select>
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="closeModal()">Cancel</button>
        <button class="add-btn" onclick="saveAppt()">Save</button>
      </div>
    </div>
  </div>

  <script>
    const now = new Date();
    let viewYear = now.getFullYear();
    let viewMonth = now.getMonth();
    let selectedDate = null;

    // appointments: { dateKey: [{id, title, person, start, end, status}] }
    const appointments = {
      [`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`]: [
        { id: 1, title: 'Medical Checkup', person: 'Martín García', start: '09:00', end: '09:30', status: 'confirmed' },
        { id: 2, title: 'Tech Consultation', person: 'Laura Paz', start: '11:00', end: '12:00', status: 'pending' },
      ]
    };
    let nextId = 10;

    const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

    function changeMonth(delta) {
      viewMonth += delta;
      if (viewMonth > 11) { viewMonth = 0; viewYear++; }
      if (viewMonth < 0)  { viewMonth = 11; viewYear--; }
      renderCalendar();
    }

    function dateKey(y, m, d) {
      return `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    }

    function renderCalendar() {
      document.getElementById('cal-month-label').textContent = `${MONTHS[viewMonth]} ${viewYear}`;
      const first = new Date(viewYear, viewMonth, 1).getDay();
      const days = new Date(viewYear, viewMonth+1, 0).getDate();
      const prevDays = new Date(viewYear, viewMonth, 0).getDate();

      let html = '';
      // Prev month padding
      for (let i = first - 1; i >= 0; i--) {
        html += `<div class="cal-cell other-month"><div class="cal-date">${prevDays - i}</div></div>`;
      }
      // This month
      for (let d = 1; d <= days; d++) {
        const key = dateKey(viewYear, viewMonth, d);
        const isToday = (d === now.getDate() && viewMonth === now.getMonth() && viewYear === now.getFullYear());
        const isSel = selectedDate === key;
        const hasAppts = appointments[key] && appointments[key].length > 0;
        let cls = 'cal-cell';
        if (isToday) cls += ' today';
        if (isSel) cls += ' selected';
        html += `<div class="${cls}" onclick="selectDate('${key}', ${d})">
          <div class="cal-date">${d}</div>
          ${hasAppts ? (appointments[key].map(() => `<span class="appt-dot"></span>`).join('')) : ''}
        </div>`;
      }
      // Next month padding
      const total = first + days;
      const remaining = total % 7 === 0 ? 0 : 7 - (total % 7);
      for (let d = 1; d <= remaining; d++) {
        html += `<div class="cal-cell other-month"><div class="cal-date">${d}</div></div>`;
      }
      document.getElementById('cal-cells').innerHTML = html;
    }

    function selectDate(key, d) {
      selectedDate = key;
      const label = `${MONTHS[viewMonth]} ${d}, ${viewYear}`;
      document.getElementById('selected-date-label').textContent = label;
      renderAppts();
      renderCalendar();
    }

    function renderAppts() {
      const list = document.getElementById('appt-list');
      if (!selectedDate) { list.innerHTML = '<div class="no-appts">Select a day to view appointments.</div>'; return; }
      const appts = (appointments[selectedDate] || []).sort((a,b) => a.start.localeCompare(b.start));
      if (appts.length === 0) {
        list.innerHTML = '<div class="no-appts">No appointments for this day.</div>';
        return;
      }
      list.innerHTML = appts.map(a => `
        <div class="appt-card">
          <div class="appt-time-col">
            <div class="appt-time">${a.start}</div>
            <div class="appt-line"></div>
            <div class="appt-time-end">${a.end}</div>
          </div>
          <div class="appt-info">
            <div class="appt-title">${a.title}</div>
            <div class="appt-sub">${a.person}</div>
            <span class="appt-status status-${a.status}">${a.status.toUpperCase()}</span>
          </div>
          <button class="appt-del" onclick="deleteAppt(${a.id})">✕</button>
        </div>
      `).join('');
    }

    function deleteAppt(id) {
      if (!selectedDate) return;
      appointments[selectedDate] = (appointments[selectedDate] || []).filter(a => a.id !== id);
      renderAppts();
      renderCalendar();
    }

    function openModal() {
      document.getElementById('modal').classList.add('open');
    }
    function closeModal() {
      document.getElementById('modal').classList.remove('open');
      ['f-title','f-person'].forEach(id => document.getElementById(id).value = '');
    }

    function saveAppt() {
      const title = document.getElementById('f-title').value.trim();
      const person = document.getElementById('f-person').value.trim();
      const start = document.getElementById('f-start').value;
      const end = document.getElementById('f-end').value;
      const status = document.getElementById('f-status').value;
      if (!title || !person) { alert('Please fill in title and person.'); return; }
      if (!selectedDate) { alert('Please select a date first.'); return; }
      if (!appointments[selectedDate]) appointments[selectedDate] = [];
      appointments[selectedDate].push({ id: nextId++, title, person, start, end, status });
      closeModal();
      renderAppts();
      renderCalendar();
    }

    // Init
    renderCalendar();
    // Auto-select today
    const todayKey = dateKey(now.getFullYear(), now.getMonth(), now.getDate());
    selectDate(todayKey, now.getDate());
  </script>
</body>
</html>
