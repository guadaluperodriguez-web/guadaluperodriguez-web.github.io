<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scientific Calculator — Guadalupe Rodríguez</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a0f; --surface: #111118; --surface2: #16161f;
      --border: rgba(255,255,255,.07); --text: #e8e8f0; --muted: #6b6b80;
      --accent: #34d399; --accent2: #a78bfa; --accent3: #f472b6;
      --btn-bg: #13131c; --btn-hover: #1c1c28; --btn-active: #22222f;
      --font-mono: 'DM Mono', monospace; --font-body: 'DM Sans', sans-serif;
    }
    body { background: var(--bg); color: var(--text); font-family: var(--font-body); min-height: 100vh; }

    .topbar {
      background: var(--surface); border-bottom: 1px solid var(--border);
      padding: .9rem 2rem; display: flex; align-items: center; gap: 1rem;
      position: sticky; top: 0; z-index: 100;
    }
    .back-btn { font-family: var(--font-mono); font-size: .72rem; color: var(--muted); text-decoration: none; border: 1px solid var(--border); padding: .35rem .9rem; transition: all .2s; }
    .back-btn:hover { border-color: var(--accent); color: var(--accent); }
    .topbar-title { font-family: var(--font-mono); font-size: .8rem; }
    .topbar-tags { display: flex; gap: .4rem; margin-left: auto; }
    .badge { font-family: var(--font-mono); font-size: .62rem; padding: .2rem .6rem; border: 1px solid var(--border); color: var(--muted); }

    .page { display: flex; gap: 2rem; padding: 3rem; max-width: 900px; margin: 0 auto; align-items: flex-start; flex-wrap: wrap; }

    /* CALCULATOR */
    .calculator { background: var(--surface); border: 1px solid var(--border); width: 340px; flex-shrink: 0; }

    .display {
      background: var(--surface2); border-bottom: 1px solid var(--border);
      padding: 1.5rem; min-height: 110px; display: flex; flex-direction: column;
      align-items: flex-end; justify-content: flex-end; gap: .4rem;
    }
    .display-expr {
      font-family: var(--font-mono); font-size: .72rem; color: var(--muted);
      word-break: break-all; text-align: right; min-height: 1.2em;
    }
    .display-val {
      font-family: var(--font-mono); font-size: 2.2rem; color: var(--accent);
      word-break: break-all; text-align: right; letter-spacing: -.02em;
      transition: font-size .1s;
    }
    .display-val.long { font-size: 1.4rem; }

    .keypad { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); }
    .key {
      background: var(--btn-bg); border: none; color: var(--text);
      font-family: var(--font-mono); font-size: .82rem; padding: 1.1rem .5rem;
      cursor: pointer; transition: all .15s; text-align: center;
      letter-spacing: .02em;
    }
    .key:hover { background: var(--btn-hover); }
    .key:active { background: var(--btn-active); transform: scale(.97); }
    .key.op { color: var(--accent2); }
    .key.fn { color: var(--muted); font-size: .72rem; }
    .key.eq { background: var(--accent); color: #0a0a0f; font-size: 1rem; }
    .key.eq:hover { background: #2dba87; }
    .key.clear { color: var(--accent3); }
    .key.zero { grid-column: span 2; }

    /* HISTORY */
    .history { flex: 1; min-width: 240px; }
    .history-title { font-family: var(--font-mono); font-size: .65rem; color: var(--muted); letter-spacing: .15em; text-transform: uppercase; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; }
    .clear-hist { background: transparent; border: 1px solid var(--border); color: var(--muted); font-family: var(--font-mono); font-size: .6rem; padding: .2rem .6rem; cursor: pointer; transition: all .2s; }
    .clear-hist:hover { border-color: var(--accent3); color: var(--accent3); }
    .history-list { display: flex; flex-direction: column; gap: .4rem; max-height: 460px; overflow-y: auto; }
    .hist-item { background: var(--surface); border: 1px solid var(--border); padding: .8rem 1rem; cursor: pointer; transition: border-color .2s; }
    .hist-item:hover { border-color: rgba(52,211,153,.3); }
    .hist-expr { font-family: var(--font-mono); font-size: .65rem; color: var(--muted); margin-bottom: .2rem; }
    .hist-result { font-family: var(--font-mono); font-size: .88rem; color: var(--accent); }
    .history-empty { font-family: var(--font-mono); font-size: .72rem; color: var(--muted); text-align: center; padding: 2rem; }

    /* Mode toggle */
    .mode-toggle { display: flex; border-bottom: 1px solid var(--border); }
    .mode-btn { flex: 1; background: transparent; border: none; color: var(--muted); font-family: var(--font-mono); font-size: .65rem; padding: .6rem; cursor: pointer; transition: all .2s; letter-spacing: .08em; text-transform: uppercase; border-bottom: 2px solid transparent; }
    .mode-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
  </style>
</head>
<body>
  <div class="topbar">
    <a href="../../index.html" class="back-btn">← Back</a>
    <span class="topbar-title">Scientific Calculator</span>
    <div class="topbar-tags">
      <span class="badge">JavaScript</span><span class="badge">HTML</span><span class="badge">CSS</span>
    </div>
  </div>

  <div class="page">
    <div class="calculator">
      <div class="mode-toggle">
        <button class="mode-btn active" onclick="setMode('basic')">Basic</button>
        <button class="mode-btn" onclick="setMode('scientific')">Scientific</button>
      </div>
      <div class="display">
        <div class="display-expr" id="disp-expr"></div>
        <div class="display-val" id="disp-val">0</div>
      </div>
      <div class="keypad" id="keypad"></div>
    </div>

    <div class="history">
      <div class="history-title">
        History
        <button class="clear-hist" onclick="clearHistory()">Clear</button>
      </div>
      <div class="history-list" id="history-list">
        <div class="history-empty" id="hist-empty">No calculations yet.</div>
      </div>
    </div>
  </div>

  <script>
    let current = '0';
    let expr = '';
    let justCalc = false;
    let mode = 'basic';
    const history = [];

    const BASIC_KEYS = [
      { label: 'AC', fn: 'clear', cls: 'clear' },
      { label: '±', fn: 'negate' },
      { label: '%', fn: 'percent', cls: 'op' },
      { label: '÷', fn: 'op', val: '/', cls: 'op' },
      { label: '7', fn: 'digit', val: '7' },
      { label: '8', fn: 'digit', val: '8' },
      { label: '9', fn: 'digit', val: '9' },
      { label: '×', fn: 'op', val: '*', cls: 'op' },
      { label: '4', fn: 'digit', val: '4' },
      { label: '5', fn: 'digit', val: '5' },
      { label: '6', fn: 'digit', val: '6' },
      { label: '−', fn: 'op', val: '-', cls: 'op' },
      { label: '1', fn: 'digit', val: '1' },
      { label: '2', fn: 'digit', val: '2' },
      { label: '3', fn: 'digit', val: '3' },
      { label: '+', fn: 'op', val: '+', cls: 'op' },
      { label: '0', fn: 'digit', val: '0', cls: 'zero' },
      { label: '.', fn: 'dot' },
      { label: '=', fn: 'equals', cls: 'eq' },
    ];

    const SCI_KEYS = [
      { label: 'sin', fn: 'sci', val: 'sin', cls: 'fn' },
      { label: 'cos', fn: 'sci', val: 'cos', cls: 'fn' },
      { label: 'tan', fn: 'sci', val: 'tan', cls: 'fn' },
      { label: 'AC', fn: 'clear', cls: 'clear' },
      { label: 'log', fn: 'sci', val: 'log', cls: 'fn' },
      { label: 'ln', fn: 'sci', val: 'ln', cls: 'fn' },
      { label: '√', fn: 'sci', val: 'sqrt', cls: 'fn' },
      { label: 'x²', fn: 'sci', val: 'sq', cls: 'fn' },
      { label: 'π', fn: 'sci', val: 'pi', cls: 'fn' },
      { label: 'e', fn: 'sci', val: 'e', cls: 'fn' },
      { label: '%', fn: 'percent', cls: 'op' },
      { label: '÷', fn: 'op', val: '/', cls: 'op' },
      { label: '7', fn: 'digit', val: '7' },
      { label: '8', fn: 'digit', val: '8' },
      { label: '9', fn: 'digit', val: '9' },
      { label: '×', fn: 'op', val: '*', cls: 'op' },
      { label: '4', fn: 'digit', val: '4' },
      { label: '5', fn: 'digit', val: '5' },
      { label: '6', fn: 'digit', val: '6' },
      { label: '−', fn: 'op', val: '-', cls: 'op' },
      { label: '1', fn: 'digit', val: '1' },
      { label: '2', fn: 'digit', val: '2' },
      { label: '3', fn: 'digit', val: '3' },
      { label: '+', fn: 'op', val: '+', cls: 'op' },
      { label: '0', fn: 'digit', val: '0', cls: 'zero' },
      { label: '.', fn: 'dot' },
      { label: '=', fn: 'equals', cls: 'eq' },
    ];

    function setMode(m) {
      mode = m;
      document.querySelectorAll('.mode-btn').forEach((b,i) => b.classList.toggle('active', (i===0&&m==='basic')||(i===1&&m==='scientific')));
      renderKeypad();
    }

    function renderKeypad() {
      const keys = mode === 'basic' ? BASIC_KEYS : SCI_KEYS;
      const cols = mode === 'basic' ? 4 : 4;
      const kp = document.getElementById('keypad');
      kp.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
      kp.innerHTML = keys.map(k =>
        `<button class="key${k.cls?' '+k.cls:''}" onclick="handle('${k.fn}','${k.val||''}')">${k.label}</button>`
      ).join('');
    }

    function updateDisplay() {
      const dv = document.getElementById('disp-val');
      const de = document.getElementById('disp-expr');
      dv.textContent = current.length > 12 ? parseFloat(current).toExponential(4) : current;
      dv.classList.toggle('long', current.length > 9);
      de.textContent = expr;
    }

    function handle(fn, val) {
      switch(fn) {
        case 'digit':
          if (justCalc) { current = val; expr = ''; justCalc = false; }
          else current = current === '0' ? val : current + val;
          break;
        case 'dot':
          if (justCalc) { current = '0.'; justCalc = false; }
          else if (!current.includes('.')) current += '.';
          break;
        case 'op':
          justCalc = false;
          expr = current + ' ' + {'/':'÷','*':'×','-':'−','+':'+'}[val] + ' ';
          current = '0';
          // store pending
          window._pendingOp = val;
          window._pendingVal = parseFloat(expr);
          break;
        case 'equals':
          if (expr && window._pendingOp) {
            const a = parseFloat(expr);
            const b = parseFloat(current);
            let result;
            switch(window._pendingOp) {
              case '+': result = a + b; break;
              case '-': result = a - b; break;
              case '*': result = a * b; break;
              case '/': result = b === 0 ? 'Error' : a / b; break;
            }
            const fullExpr = expr + current;
            result = typeof result === 'number' ? parseFloat(result.toFixed(10)).toString() : result;
            addHistory(fullExpr, result);
            expr = fullExpr + ' =';
            current = result;
            justCalc = true;
            window._pendingOp = null;
          }
          break;
        case 'clear':
          current = '0'; expr = ''; justCalc = false; window._pendingOp = null;
          break;
        case 'negate':
          current = String(-parseFloat(current));
          break;
        case 'percent':
          current = String(parseFloat(current) / 100);
          break;
        case 'sci':
          const n = parseFloat(current);
          let res;
          const DEG = Math.PI / 180;
          switch(val) {
            case 'sin': res = Math.sin(n * DEG); break;
            case 'cos': res = Math.cos(n * DEG); break;
            case 'tan': res = Math.tan(n * DEG); break;
            case 'log': res = Math.log10(n); break;
            case 'ln': res = Math.log(n); break;
            case 'sqrt': res = Math.sqrt(n); break;
            case 'sq': res = n * n; break;
            case 'pi': current = String(Math.PI); updateDisplay(); return;
            case 'e': current = String(Math.E); updateDisplay(); return;
          }
          const sciExpr = `${val}(${current})`;
          res = parseFloat(res.toFixed(10)).toString();
          addHistory(sciExpr, res);
          expr = sciExpr + ' =';
          current = res;
          justCalc = true;
          break;
      }
      updateDisplay();
    }

    function addHistory(expression, result) {
      history.unshift({ expression, result });
      if (history.length > 20) history.pop();
      renderHistory();
    }

    function clearHistory() { history.length = 0; renderHistory(); }

    function renderHistory() {
      const list = document.getElementById('history-list');
      const empty = document.getElementById('hist-empty');
      if (history.length === 0) {
        list.innerHTML = '<div class="history-empty" id="hist-empty">No calculations yet.</div>';
        return;
      }
      list.innerHTML = history.map((h, i) => `
        <div class="hist-item" onclick="useHistory(${i})">
          <div class="hist-expr">${h.expression}</div>
          <div class="hist-result">= ${h.result}</div>
        </div>
      `).join('');
    }

    function useHistory(i) {
      current = history[i].result;
      expr = '';
      justCalc = false;
      updateDisplay();
    }

    // Keyboard support
    document.addEventListener('keydown', e => {
      if (e.key >= '0' && e.key <= '9') handle('digit', e.key);
      else if (e.key === '.') handle('dot', '');
      else if (e.key === '+') handle('op', '+');
      else if (e.key === '-') handle('op', '-');
      else if (e.key === '*') handle('op', '*');
      else if (e.key === '/') { e.preventDefault(); handle('op', '/'); }
      else if (e.key === 'Enter' || e.key === '=') handle('equals', '');
      else if (e.key === 'Escape') handle('clear', '');
      else if (e.key === 'Backspace') {
        current = current.length > 1 ? current.slice(0, -1) : '0';
        updateDisplay();
      }
    });

    // Init
    renderKeypad();
    updateDisplay();
  </script>
</body>
</html>
